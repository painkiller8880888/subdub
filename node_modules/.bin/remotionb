else
  export NODE_PATH="/mnt/c/Users/ken/Desktop/subdub/node_modules/.pnpm/@remotion+cli@4.0.499_light_29f9cb9683c6e1d3705a8dcb71dfeea6/node_modules/@remotion/cli/node_modules:/mnt/c/Users/ken/Desktop/subdub/node_modules/.pnpm/@remotion+cli@4.0.499_light_29f9cb9683c6e1d3705a8dcb71dfeea6/node_modules:/mnt/c/Users/ken/Desktop/subdub/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/bun.exe" ]; then
  exec "$basedir/bun.exe"  "$basedir_win/../@remotion/cli/remotionb-cli.js" "$@"
elif [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../@remotion/cli/remotionb-cli.js" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun  "$basedir/../@remotion/cli/remotionb-cli.js" "$@"
elif [ -n "$exe" ] && command -v bun.exe >/dev/null 2>&1; then
  exec bun.exe  "$basedir_win/../@remotion/cli/remotionb-cli.js" "$@"
