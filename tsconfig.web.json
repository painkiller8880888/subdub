{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "src/schema/**/*.ts",
    "src/screen-layout-resolver.ts",
    "src/remotion/**/*.ts",
    "src/remotion/**/*.tsx",
    "src/web/**/*.ts",
    "src/web/**/*.tsx"
  ]
}
