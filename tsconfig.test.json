{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest"]
  },
  "include": [
    "scripts/verify-character-assets.ts",
    "scripts/seed-character-visual-catalog.ts",
    "tests/**/*.ts",
    "src/api/**/*.ts",
    "src/app/**/*.ts",
    "src/db/**/*.ts",
    "src/openrouter/**/*.ts",
    "src/voicevox/**/*.ts",
    "src/schema/**/*.ts",
    "src/screen-layout-resolver.ts",
    "src/screen-template-style.ts",
    "src/screen-template-typography.ts",
    "src/media-frame.ts",
    "src/assets/**/*.ts",
    "src/validation/**/*.ts",
    "src/timeline/**/*.ts"
  ]
}
