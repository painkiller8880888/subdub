{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "vitest"]
  },
  "include": [
    "scripts/verify-character-assets.ts",
    "tests/**/*.ts",
    "src/api/**/*.ts",
    "src/app/**/*.ts",
    "src/db/**/*.ts",
    "src/openrouter/**/*.ts",
    "src/schema/**/*.ts",
    "src/assets/**/*.ts",
    "src/validation/**/*.ts",
    "src/timeline/**/*.ts"
  ]
}
