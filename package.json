{
  "name": "subdub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/api/dev.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:character-assets": "node node_modules/tsx/dist/cli.mjs scripts/verify-character-assets.ts",
    "verify:voicevox": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/verify-voicevox.mjs",
    "start": "node --env-file-if-exists=.env dist/api/production.js",
    "verify": "node scripts/verify.mjs",
    "verify:openrouter:outline": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/verify-openrouter-outline.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "8.2.0",
    "@mediabunny/server": "1.52.3",
    "@napi-rs/canvas": "1.0.3",
    "@remotion/player": "4.0.499",
    "@tanstack/react-query": "5.101.4",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "mediabunny": "1.52.3",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.0",
    "remotion": "4.0.499",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "@types/node": "24.0.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
